# ---------------------------------------------------------------------------
# HR Portal — environment variables (reference; copy to .env.local and fill in)
# Never commit real values. See docs/ARCHITECTURE.md §10.
# ---------------------------------------------------------------------------

# Supabase project URL (Project Settings → API). Public.
NEXT_PUBLIC_SUPABASE_URL=
# Supabase anon/public key. Public — access is enforced by RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Supabase service-role key. SERVER ONLY — never expose to the browser or commit.
SUPABASE_SERVICE_ROLE_KEY=

# Absolute public URL of this deployment (used in email links, QR verification URLs).
# e.g. http://localhost:3000 locally, https://hr.example.com in production
NEXT_PUBLIC_SITE_URL=

# Email of the first Super Admin — only read by `pnpm bootstrap:super-admin`.
SUPER_ADMIN_EMAIL=

# --- Email delivery (optional) ---------------------------------------------
# Option A: Resend REST API key. If set, Resend is used.
RESEND_API_KEY=
# Sender address, e.g. "HR Portal <hr@example.com>" (must be a verified domain for Resend).
EMAIL_FROM=
# Option B: SMTP (used when RESEND_API_KEY is empty and SMTP_HOST is set).
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
# "true" for implicit TLS (port 465), "false" for STARTTLS (port 587).
SMTP_SECURE=
# If neither Resend nor SMTP is configured, emails are recorded in email_logs with status "skipped".

# --- PDF rendering -----------------------------------------------------------
# Local only: path to a Chrome/Chromium binary for puppeteer-core.
# On Vercel leave empty — @sparticuz/chromium is used.
CHROMIUM_EXECUTABLE_PATH=

# --- Scheduled jobs ------------------------------------------------------------
# Shared secret for /api/cron/* (Vercel Cron sends it as a Bearer token).
CRON_SECRET=
